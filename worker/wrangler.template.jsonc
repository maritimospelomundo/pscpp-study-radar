{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pscpp-study-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://maritimospelomundo.github.io",
    "STUDENT_ID": "gustavo"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pscpp-study-radar-db",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ]
}
